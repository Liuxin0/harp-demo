geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e14" source="fit" target="reference" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#78648c;dashed=1;exitX=1;exitY=0.49230769230769234;entryX=0;entryY=0.49230769230769234;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="input" value="Band-limited&#10;LR waveform" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="25" y="200" width="130" height="65" as="geometry"/></mxCell><mxCell id="stft" value="STFT&#10;magnitude + phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="200" width="130" height="65" as="geometry"/></mxCell><mxCell id="feature" value="Mixed-carrier features&#10;257 STFT → 128 ERB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fff2cc;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="385" y="90" width="190" height="70" as="geometry"/></mxCell><mxCell id="predictor" value="Compact predictor&#10;4 causal Conv + 2 GRU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e4dfec;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="90" width="210" height="70" as="geometry"/></mxCell><mxCell id="heads" value="Two WGMM heads&#10;weights · spreads · gains" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e4dfec;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="90" width="205" height="70" as="geometry"/></mxCell><mxCell id="mixed" value="Mixed magnitude carrier&#10;LR + rectified-LR path" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="385" y="265" width="190" height="70" as="geometry"/></mxCell><mxCell id="flat" value="Flat aperiodic carrier&#10;W = exp(−1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fce4d6;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="365" width="210" height="60" as="geometry"/></mxCell><mxCell id="renderer" value="Dual-branch renderer&#10;Periodic + aperiodic&#10;LAEA on aperiodic only" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fce4d6;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="265" width="205" height="85" as="geometry"/></mxCell><mxCell id="sum" value="+" style="ellipse;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e2f0d9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y="280" width="55" height="55" as="geometry"/></mxCell><mxCell id="synth" value="Waveform synthesis&#10;iSTFT&#10;reconstructed speech" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e2f0d9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1245" y="265" width="175" height="85" as="geometry"/></mxCell><mxCell id="phase" value="Phase-flipped&#10;LR phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1245" y="395" width="175" height="60" as="geometry"/></mxCell><mxCell id="note" value="Observed LR magnitude is retained in the final magnitude sum." style="text;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=17;fontColor=#1f2937;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="355" y="465" width="760" height="45" as="geometry"/></mxCell><mxCell id="analysis-title" value="ANALYSIS ONLY · not a deployment input or a source of training supervision" style="text;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=17;fontColor=#1f2937;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="1380" height="40" as="geometry"/></mxCell><mxCell id="target" value="Paired LR / HR targets&#10;HF residual" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f4f1f7;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="230" height="65" as="geometry"/></mxCell><mxCell id="fit" value="HR-informed EM-style fitting&#10;Related fixed-centre dual-carrier family" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f4f1f7;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="370" height="65" as="geometry"/></mxCell><mxCell id="reference" value="Target-side representational reference&#10;LSD 0.65; not a deployable condition" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f4f1f7;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="610" width="370" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02 Branch renderer and LAEA" id="renderer"><mxGraphModel dx="1440" dy="710" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="710" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HARP · inside the du