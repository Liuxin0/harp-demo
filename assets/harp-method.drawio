=0;entryPerimeter=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="bv" value="Mixed carrier Bv&#10;Harmonic support" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="35" y="175" width="205" height="70" as="geometry"/></mxCell><mxCell id="ev" value="Periodic WGMM + frame gain&#10;Ev(f,t) and Gv(t)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e4dfec;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="345" y="75" width="255" height="70" as="geometry"/></mxCell><mxCell id="pv" value="Periodic contribution&#10;Pv = Gv × Bv × Ev" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="175" width="245" height="70" as="geometry"/></mxCell><mxCell id="bc" value="Flat carrier W&#10;Deterministic support" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fce4d6;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="35" y="345" width="205" height="70" as="geometry"/></mxCell><mxCell id="ec" value="Aperiodic WGMM + frame gain&#10;Ec(f,t) and Gc(t)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e4dfec;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="345" y="455" width="255" height="70" as="geometry"/></mxCell><mxCell id="pre" value="Candidate aperiodic contribution&#10;Apre = Gc × W × Ec" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fce4d6;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="345" y="345" width="255" height="70" as="geometry"/></mxCell><mxCell id="laea" value="LAEA local calibration&#10;Acal = exp(m × log Apre)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#fce4d6;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="345" width="245" height="70" as="geometry"/></mxCell><mxCell id="lr-local" value="LR local log magnitude&#10;conditions LAEA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="455" width="245" height="70" as="geometry"/></mxCell><mxCell id="lr-add" value="Observed LR magnitude&#10;retained in output" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="75" width="220" height="70" as="geometry"/></mxCell><mxCell id="addition" value="+" style="ellipse;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e2f0d9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="270" width="60" height="60" as="geometry"/></mxCell><mxCell id="magnitude" value="Reconstructed magnitude&#10;|LR| + Pv + Acal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=18;fontColor=#1f2937;fillColor=#e2f0d9;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="255" width="230" height="90" as="geometry"/></mxCell><mxCell id="explain" value="LAEA acts only on the assembled aperiodic log branch: u = log Apre; m = mask(u + log|LR|), 0 &lt; m &lt; 1.&#10;This is exponent calibration, not linear-amplitude masking. WGMM weights still affect level; gain is not a unique scale coordinate." style="text;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=17;fontColor=#1f2937;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="575" width="1340" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>